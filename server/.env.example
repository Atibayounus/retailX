PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pos
# Use a long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
TAX_RATE=0.0
CLIENT_URL=http://localhost:5173
# Set true if Atlas SRV lookup fails on Windows (querySrv ECONNREFUSED)
USE_GOOGLE_DNS=false
# Timezone used for the daily revenue chart
REPORT_TIMEZONE=Asia/Karachi
# In production set NODE_ENV=production (enforces a strong JWT_SECRET)
# If the API sits behind a reverse proxy (nginx, Render, Railway...), set TRUST_PROXY=1
#NODE_ENV=production
#TRUST_PROXY=1
